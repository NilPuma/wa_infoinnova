<div id="bodyAdministrador">
    
    {{!-- ==================== MENÚ LATERAL ==================== --}}
    <div id="sideMenu" class="menu-colapsado">
        {{!-- Header del menú --}}
        <div id="cabecera">
            <div id="titulo"><span>AGL - GROUP</span></div>
            <div id="menuBtn">
                <div class="btn-hamburger"></div>
                <div class="btn-hamburger"></div>
                <div class="btn-hamburger"></div>
            </div>
        </div>

        {{!-- Perfil de usuario --}}
        <div id="perfil">
            <div id="foto"><img src="/img/perfil.png" alt="Foto de perfil"></div>
            <div id="nombre"><span>CLIENTE</span></div>
        </div>

        {{!-- Items del menú --}}
        <div id="menuItems">
            <div class="item">
                <a href="#" id="btnMenuArchivos">
                    <div class="icono"><img src="/icons/certificados.svg" alt="" ></div>
                    <div class="titulo"><span>Certificados</span></div>
                </a>
            </div>
            <div class="item-separator"></div>

            <div class="item">
                <a href="#" id="btnMenuNotificacion">
                    <div class="icono"><img src="/icons/notificacion.svg" alt="Notificación"></div>
                    <div class="titulo"><span>Notificación</span></div>
                </a>
            </div>
            <div class="item-separator"></div>

            <div class="item">
                <a href="#" id="btnMenuConfiguracion">
                    <div class="icono"><img src="/icons/config.svg" alt="" ></div>
                    <div class="titulo"><span>Configuración</span></div>
                </a>
            </div>
            <div class="item-separator"></div>

            <div class="item">
                <a href="#" id="btnMenuCerrar">
                    <div class="icono"><img src="/icons/turn-off.svg" alt="Cerrar Sesión"></div>
                    <div class="titulo"><span>Cerrar Sesion</span></div>
                </a>
            </div>
        </div>
    </div>

    {{!-- ==================== ÁREA PRINCIPAL DE TRABAJO ==================== --}}
    <section id="contenedorPrincipal">
        <div id="header">
            <div class="contenedor-header row d-flex align-items-center">
                <div class="col">
                    {{!-- Espacio para breadcrumb o título --}}
                </div>
                <div class="col text-end">
                    {{!-- Espacio para acciones rápidas --}}
                </div>
            </div>
        </div>

        {{!-- Área reactiva donde se renderiza el contenido --}}
        <div class="row">
            <div class="col">
                <div id="contenedorReactivo">
                    {{!-- El contenido se cargará automáticamente al iniciar --}}
                </div>

                {{!-- ==================== TEMPLATES ==================== --}}
                
                {{!-- Template: Vista de Certificados --}}
                <template id="templateArchivos">
                    <div id="certificados" class="p-4 container">
                        {{!-- Card de Certificados --}}
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-0">
                                {{!-- Título y buscador dentro de la card --}}
                                <div class="p-4 pb-3 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <h5 class="fw-bold mb-0">
                                            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                                            Mis Certificados
                                        </h5>
                                        
                                        {{!-- Buscador --}}
                                        <div class="input-group input-group-sm" style="max-width: 320px;">
                                            <span class="input-group-text bg-white">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input type="text" 
                                                class="form-control form-control-sm" 
                                                id="inputBuscarCertificado" 
                                                placeholder="Buscar por código o nombre...">
                                        </div>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">CÓDIGO</th>
                                                <th>TITULO</th>
                                                <th>FECHA DE EMISIÓN</th>
                                                <th class="text-center">ACCIÓN</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tabla-certificados-body">
                                            {{!-- Se llena dinámicamente con JavaScript --}}
                                        </tbody>
                                    </table>
                                </div>

                                {{!-- Info, Selector de registros y Paginación --}}
                                <div class="p-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <div class="small text-muted" id="infoPaginacion">
                                                {{!-- Se llena dinámicamente --}}
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <label class="small text-muted mb-0">Mostrar:</label>
                                                <select id="selectRegistrosPorPagina" class="form-select form-select-sm">
                                                    <option value="3">3</option>
                                                    <option value="5" selected>5</option>
                                                    <option value="10">10</option>
                                                    <option value="20">20</option>
                                                </select>
                                            </div>
                                        </div>

                                        <nav aria-label="Paginación de certificados">
                                            <ul class="pagination pagination-sm mb-0" id="paginacionCertificados">
                                                {{!-- Se llena dinámicamente con JavaScript --}}
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                {{!-- Template: Vista de Notificaciones --}}
                <template id="templateNotificacion">
                    <div id="notificaciones" class="p-4 container">
                        {{!-- Card de Notificaciones --}}
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-0">
                                {{!-- Título dentro de la card --}}
                                <div class="p-4 pb-3 border-bottom">
                                    <h5 class="fw-bold mb-0">
                                        <i class="bi bi-bell me-2 text-primary"></i>
                                        Notificaciones
                                    </h5>
                                </div>

                                {{!-- Lista de Notificaciones --}}
                                <div id="listaNotificaciones" class="p-4">
                                    {{!-- Se llena dinámicamente con JavaScript --}}
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                {{!-- Template: Vista de Configuración --}}
                <template id="templateConfiguracion">
                    <div id="configuracion" class="p-4 container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                {{!-- Card de Datos Personales --}}
                                <div class="card shadow-sm border-0">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold mb-4">
                                            <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                                            Datos Personales
                                        </h5>

                                        <form id="formConfiguracion" class="needs-validation" novalidate>
                                            {{!-- Fila 1: Nombres y Apellidos --}}
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <label for="configNombres" class="form-label small fw-semibold">Nombres</label>
                                                    <input type="text" 
                                                           class="form-control form-control-sm" 
                                                           id="configNombres" 
                                                           placeholder="Ingrese sus nombres"
                                                           required>
                                                    <div class="invalid-feedback">Ingrese sus nombres.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label for="configApellidos" class="form-label small fw-semibold">Apellidos</label>
                                                    <input type="text" 
                                                           class="form-control form-control-sm" 
                                                           id="configApellidos" 
                                                           placeholder="Ingrese sus apellidos"
                                                           required>
                                                    <div class="invalid-feedback">Ingrese sus apellidos.</div>
                                                </div>
                                            </div>

                                            {{!-- Fila 2: DNI y Teléfono --}}
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <label for="configDni" class="form-label small fw-semibold">DNI</label>
                                                    <input type="text" 
                                                           class="form-control form-control-sm" 
                                                           id="configDni" 
                                                           placeholder="Ingrese su DNI"
                                                           maxlength="8"
                                                           required>
                                                    <div class="invalid-feedback">Ingrese su DNI.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label for="configTelefono" class="form-label small fw-semibold">Teléfono</label>
                                                    <input type="tel" 
                                                           class="form-control form-control-sm" 
                                                           id="configTelefono" 
                                                           placeholder="Ingrese su teléfono"
                                                           required>
                                                    <div class="invalid-feedback">Ingrese su teléfono.</div>
                                                </div>
                                            </div>

                                            {{!-- Fila 3: Dirección --}}
                                            <div class="row g-3 mb-4">
                                                <div class="col-12">
                                                    <label for="configDireccion" class="form-label small fw-semibold">Dirección</label>
                                                    <input type="text" 
                                                           class="form-control form-control-sm" 
                                                           id="configDireccion" 
                                                           placeholder="Ingrese su dirección">
                                                </div>
                                            </div>

                                            {{!-- Botones de acción --}}
                                            <div class="d-flex justify-content-end gap-2">
                                                <button type="button" class="btn btn-cancelar" id="btnCancelarConfiguracion">
                                                    <i class="bi bi-x-circle me-2"></i>
                                                    Cancelar
                                                </button>
                                                <button type="submit" class="btn btn-primario" id="btnGuardarConfiguracion">
                                                    <i class="bi bi-check-circle me-2"></i>
                                                    Guardar Cambios
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </section>

    {{!-- ==================== MODAL: VER CERTIFICADO ==================== --}}
    <div class="modal fade" id="modalVerCertificado" tabindex="-1" aria-labelledby="modalCertificadoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                {{!-- Header del modal --}}
                <div class="modal-header border-0 px-4 pt-4 pb-2">
                    <h6 class="modal-title fw-bold" id="modalCertificadoLabel">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        Detalle del Certificado
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                {{!-- Cuerpo del modal --}}
                <div class="modal-body px-4 pb-4">
                    {{!-- Información del certificado --}}
                    <div class="d-flex flex-column gap-3">
                        {{!-- Código --}}
                        <div class="row align-items-center">
                            <div class="col-5">
                                <label class="small fw-bold mb-0">Código:</label>
                            </div>
                            <div class="col-7">
                                <p class="mb-0" id="modalCertificadoCodigo"></p>
                            </div>
                        </div>

                        {{!-- Fecha de Emisión --}}
                        <div class="row align-items-center">
                            <div class="col-5">
                                <label class="small fw-bold mb-0">Fecha de Emisión:</label>
                            </div>
                            <div class="col-7">
                                <p class="mb-0" id="modalCertificadoFecha"></p>
                            </div>
                        </div>

                        {{!-- Nombre del Certificado --}}
                        <div class="row align-items-center">
                            <div class="col-5">
                                <label class="small fw-bold mb-0">Nombre del Certificado:</label>
                            </div>
                            <div class="col-7">
                                <p class="fw-semibold mb-0" id="modalCertificadoNombre"></p>
                            </div>
                        </div>

                        {{!-- Descripción --}}
                        <div class="row align-items-start">
                            <div class="col-5">
                                <label class="small fw-bold mb-0">Descripción:</label>
                            </div>
                            <div class="col-7">
                                <p class="mb-0" id="modalCertificadoDescripcion"></p>
                            </div>
                        </div>
                    </div>
                </div>

                {{!-- Footer del modal --}}
                <div class="modal-footer border-0 px-4 pb-4 pt-0 justify-content-center">
                    <button type="button" class="btn btn-cancelar btn-sm px-4" id="btnDescargarCertificado">
                        <i class="bi bi-file-earmark-pdf me-2"></i>
                        Descargar PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    {{!-- ==================== MODAL: CERRAR SESIÓN (MINIMALISTA) ==================== --}}
    <div class="modal fade" id="modalCerrarSesion" tabindex="-1" aria-labelledby="modalCerrarSesionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                {{!-- Cuerpo del modal --}}
                <div class="modal-body text-center p-4">
                    {{!-- Icono --}}
                    <div class="mb-3">
                        <i class="bi bi-box-arrow-right modal-icono-cerrar"></i>
                    </div>
                    
                    {{!-- Título --}}
                    <h6 class="fw-bold mb-1" id="modalCerrarSesionLabel">Cerrar Sesión</h6>
                    
                    {{!-- Subtítulo --}}
                    <p class="mb-4 modal-subtitulo-cerrar">¿Desea salir del sistema?</p>
                    
                    {{!-- Botones --}}
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-link btn-sm px-3 py-2 text-decoration-none btn-cancelar-modal" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-cancelar btn-sm px-3 py-2" id="btnConfirmarCerrarSesion">
                            Salir
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- ==================== TOAST PERSONALIZADO ==================== --}}
    <div id="toastContainer" class="toast-container-custom" aria-live="polite" aria-atomic="true">
        <div id="toastCertificado" class="toast-personalizado" role="alert">
            <i id="toastIcono" class="bi toast-icono"></i>
            <div class="toast-contenido">
                <p id="toastTitulo" class="toast-titulo mb-0"></p>
                <p id="toastMensaje" class="toast-mensaje mb-0"></p>
            </div>
            <button type="button" id="toastCerrar" class="toast-cerrar" aria-label="Cerrar notificación">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

</div>
<script src="/js/cliente.js"></script>