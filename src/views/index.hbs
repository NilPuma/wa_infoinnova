    <section id="contactanos" class="seccion-contacto">
      <div class="container">
        <div class="row align-items-stretch justify-content-center g-4 g-lg-5">

          <!-- Imagen -->
          <div class="col-lg-5 d-none d-lg-block" data-aos="fade-right">
            <div class="contacto-imagen">
              <img src="/img/contactanos.jpg" alt="Contáctanos - Innova Sistemas">
            </div>
          </div>

          <!-- Formulario -->
          <div class="col-lg-7 col-xl-6" data-aos="fade-left">
            <div class="contacto-card p-4">
              <div class="contacto-contenido text-center">

                <div class="contacto-header mb-3">
                  <span class="antetitulo antetitulo--bloque">Contáctanos</span>
                  <h2 class="titulo-seccion">Contacto</h2>
                  <p class="contacto-subtitulo mx-auto">
                    <strong>Envía un mensaje y uno de nuestros asesores se contactará contigo.</strong>
                  </p>
                </div>

                <form id="contactForm" novalidate>

                  <!-- Fila 1: Documento/RUC | Nombre/Razón Social -->
                  <div class="row g-2 mb-2">
                    <div class="col-md-6">
                      <div class="input-style">
                        <input type="text" id="documentoContacto" placeholder=" " required>
                        <label for="documentoContacto">
                          <i class="bi bi-card-text me-1"></i>Documento/RUC
                        </label>
                        <span class="input-style-error">Ingrese su documento o RUC.</span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="input-style">
                        <input type="text" id="nombreContacto" placeholder=" " required>
                        <label for="nombreContacto">
                          <i class="bi bi-person me-1"></i>Nombre/Razón Social
                        </label>
                        <span class="input-style-error">Ingrese su nombre o razón social.</span>
                      </div>
                    </div>
                  </div>

                  <!-- Fila 2: Correo | Teléfono -->
                  <div class="row g-2 mb-2">
                    <div class="col-md-6">
                      <div class="input-style">
                        <input type="email" id="correoContacto" placeholder=" " required>
                        <label for="correoContacto">
                          <i class="bi bi-envelope me-1"></i>Correo
                        </label>
                        <span class="input-style-error">Ingrese su correo.</span>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="input-style">
                        <input type="tel" id="telefonoContacto" placeholder=" " required>
                        <label for="telefonoContacto">
                          <i class="bi bi-telephone me-1"></i>Teléfono
                        </label>
                        <span class="input-style-error">Ingrese su número telefónico.</span>
                      </div>
                    </div>
                  </div>

                  <!-- Mensaje -->
                  <div class="input-style mb-3">
                    <textarea id="mensajeContacto" placeholder=" " required></textarea>
                    <label for="mensajeContacto">
                      <i class="bi bi-chat-left-text me-1"></i>Mensaje
                    </label>
                    <span class="input-style-error">Escriba un mensaje.</span>
                  </div>

                  <!-- Botón de envío -->
                  <button type="button" class="btn-primario foco-visible" id="btnEnviarSms">
                    <span>Registra tu mensaje</span>
                    
                  </button>

                </form>

              </div>
            </div>
          </div>

        </div>
      </div>
